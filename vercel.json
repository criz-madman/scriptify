{
  "version": 2,
  "buildCommand": "cd backend && npm install",
  "builds": [
    {
      "src": "backend/src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/server.js"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/frontend/images/$1"
    },
    {
      "src": "/myimages/(.*)",
      "dest": "/frontend/myimages/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/frontend/myimages/scriptfy icon.png"
    },
    {
      "src": "/login",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "/frontend/dashboard.html"
    },
    {
      "src": "/panel-builder",
      "dest": "/frontend/panel-builder.html"
    },
    {
      "src": "/text-animator",
      "dest": "/frontend/text-animator.html"
    },
    {
      "src": "/presets",
      "dest": "/frontend/presets.html"
    },
    {
      "src": "/marketplace",
      "dest": "/frontend/presets.html"
    },
    {
      "src": "/shop",
      "dest": "/frontend/presets.html"
    },
    {
      "src": "/wallet",
      "dest": "/frontend/wallet.html"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
