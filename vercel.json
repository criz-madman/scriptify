{
  "version": 2,
  "buildCommand": "cd backend && npm install",
  "builds": [
    {
      "src": "backend/src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/server.js"
    },
    {
      "src": "/health",
      "dest": "backend/src/server.js"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/frontend/images/$1"
    },
    {
      "src": "/myimages/(.*)",
      "dest": "/frontend/myimages/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/frontend/myimages/scriptfy%20icon.png"
    },
    {
      "src": "/login",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/register",
      "dest": "/frontend/register.html"
    },
    {
      "src": "/dashboard",
      "dest": "/frontend/dashboard.html"
    },
    {
      "src": "/explore",
      "dest": "/frontend/explore.html"
    },
    {
      "src": "/profile",
      "dest": "/frontend/profile.html"
    },
    {
      "src": "/panel-builder",
      "dest": "/frontend/panel-builder.html"
    },
    {
      "src": "/text-animator",
      "dest": "/frontend/text-animator.html"
    },
    {
      "src": "/presets",
      "dest": "/frontend/presets.html"
    },
    {
      "src": "/marketplace",
      "dest": "/frontend/presets.html"
    },
    {
      "src": "/shop",
      "dest": "/frontend/presets.html"
    },
    {
      "src": "/checkout",
      "dest": "/frontend/checkout.html"
    },
    {
      "src": "/wallet",
      "dest": "/frontend/wallet.html"
    },
    {
      "src": "/history",
      "dest": "/frontend/history.html"
    },
    {
      "src": "/admin",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "/contact",
      "dest": "/frontend/contact.html"
    },
    {
      "src": "/copyright",
      "dest": "/frontend/copyright.html"
    },
    {
      "src": "/privacy",
      "dest": "/frontend/privacy.html"
    },
    {
      "src": "/privacy-policy",
      "dest": "/frontend/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/frontend/terms.html"
    },
    {
      "src": "/terms-of-service",
      "dest": "/frontend/terms.html"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
