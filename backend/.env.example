# Scriptify Backend Environment Configuration

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
# Option A: Full Supabase / PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scriptify_db

# Option B: Individual PostgreSQL Parameters (Used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=scriptify_db
# Set PGSSL=true for Supabase or managed cloud PostgreSQL
PGSSL=false

# Authentication & JWT
JWT_SECRET=scriptify_super_secret_jwt_key_production_2026_ae
JWT_EXPIRES_IN=7d

# Email OTP Service Configuration (Nodemailer)
# If left empty, OTP will be printed to backend console & API response for dev testing
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Scriptify Support" <no-reply@scriptify.dev>

# Platform Economy Rules
INITIAL_CREDITS=100
COST_PER_SCRIPT=1

# Allowed Frontend Origins (CORS)
CLIENT_URL=http://localhost:5000,http://127.0.0.1:5000
